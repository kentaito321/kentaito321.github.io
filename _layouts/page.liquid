---
layout: default
---
<div class="px-6 pt-12 pb-16">
  <header class="mb-8 md:px-24">
    <h1 class="text-3xl font-bold capitalize">{{ page.title }}</h1>
    {% if page.description %}
      <p class="mt-2 font-extralight text-slate-600 dark:text-slate-300">{{ page.description }}</p>
    {% endif %}
  </header>

  <article class="font-extralight md:px-24">
    {{ content }}
  </article>
</div>
