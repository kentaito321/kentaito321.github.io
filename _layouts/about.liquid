---
layout: default
---
<section style="min-height: calc(100vh - 10vh); display: flex; flex-direction: column; justify-content: center; align-items: center; padding-top: 3rem; padding-bottom: 3rem;">

  <!-- Profile -->
  <section id="portfolio" class="mb-12 w-full px-6">
    <figure class="md:flex md:items-center">
      {% if page.profile and page.profile.image %}
        {% assign profile_image = page.profile.image | prepend: '/assets/img/' %}
        <img class="w-48 h-48 rounded-full mx-auto md:mx-12 object-cover flex-shrink-0"
             src="{{ profile_image | relative_url }}"
             alt="{{ site.first_name }} {{ site.last_name }}">
      {% endif %}
      <div class="text-center md:text-left mt-6 md:mt-0">
        <figcaption class="font-extralight leading-snug pt-2">
          <div class="text-2xl font-bold">{{ site.first_name }} {{ site.last_name }}</div>
          <div class="py-3 text-slate-600 dark:text-slate-300">{{ page.subtitle }}</div>

          <!-- Social links -->
          <div class="pt-2 flex flex-wrap justify-center md:justify-start gap-3 text-slate-700 dark:text-slate-200">
            {% if site.email %}
              <a href="mailto:{{ site.email }}" title="Email" class="hover:opacity-70">
                <i class="fa-solid fa-envelope fa-lg"></i>
              </a>
            {% endif %}
            {% if site.scholar_userid %}
              <span class="opacity-40">|</span>
              <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}" target="_blank" title="Google Scholar" class="hover:opacity-70">
                <i class="ai ai-google-scholar-square ai-lg"></i>
              </a>
            {% endif %}
            {% if site.orcid_id %}
              <a href="https://orcid.org/{{ site.orcid_id }}" target="_blank" title="ORCID" class="hover:opacity-70">
                <i class="fa-brands fa-orcid fa-lg"></i>
              </a>
            {% endif %}
            {% if site.linkedin_username %}
              <a href="https://www.linkedin.com/in/{{ site.linkedin_username }}" target="_blank" title="LinkedIn" class="hover:opacity-70">
                <i class="fa-brands fa-linkedin fa-lg"></i>
              </a>
            {% endif %}
            {% if site.github_username %}
              <a href="https://github.com/{{ site.github_username }}" target="_blank" title="GitHub" class="hover:opacity-70">
                <i class="fa-brands fa-github fa-lg"></i>
              </a>
            {% endif %}
            {% if site.x_username %}
              <a href="https://twitter.com/{{ site.x_username }}" target="_blank" title="X / Twitter" class="hover:opacity-70">
                <i class="fa-brands fa-x-twitter fa-lg"></i>
              </a>
            {% endif %}
          </div>
        </figcaption>
      </div>
    </figure>
  </section>

  <!-- Bio -->
  <section id="bio" class="max-w-4xl mx-auto font-extralight md:px-24 px-6 text-justify">
    {{ content }}
  </section>

</section>
