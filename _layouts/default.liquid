<!doctype html>
<html lang="{{ site.lang }}" class="font-sans">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ site.title }}</title>
  <script>
    // Apply dark mode before render to avoid flash
    const _stored = localStorage.getItem('theme');
    const _prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (_stored === 'dark' || (!_stored && _prefersDark)) {
      document.documentElement.classList.add('dark');
    }
  </script>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { darkMode: 'class' }
  </script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/academicons/1.9.4/css/academicons.min.css">
  <script src="{{ '/assets/js/theme.js' | relative_url }}" defer></script>
  <style>
    @keyframes open-menu {
      0% { transform: scaleY(0); }
      80% { transform: scaleY(1.1); }
      100% { transform: scaleY(1); }
    }
    .animate-open-menu { animation: open-menu 0.15s ease-in-out forwards; }
    /* Spacing + link styling for markdown-generated content in the bio */
    #bio p { margin-top: 1.25rem; }
    #bio p:first-child { margin-top: 0; }
    #bio a { text-decoration: underline; text-underline-offset: 2px; }
    /* jekyll-scholar output. It puts .bib-list on both the year group heading
       and the container holding the cards, so they're separated by tag here. */
    div.bib-list { display: flex; flex-direction: column; gap: 1rem; }
    h3.bib-list {
      margin-top: 3rem;
      margin-bottom: 1.5rem;
      padding-bottom: 0.5rem;
      text-align: right;
      font-size: 2.25rem;
      line-height: 2.5rem;
      font-weight: 700;
      color: #e2e8f0;                      /* slate-200 */
      user-select: none;
      border-bottom: 1px solid #e2e8f0;    /* slate-200 */
    }
    h3.bib-list:first-child { margin-top: 0; }
    .dark h3.bib-list { color: #1e293b; border-bottom-color: #334155; }
  </style>
</head>
<body class="min-h-screen bg-white dark:bg-slate-950 text-slate-900 dark:text-white font-medium">

  <!-- Header -->
  <header class="bg-slate-500/50 dark:bg-slate-700/50 sticky top-0 z-10 font-extralight">
    <section class="backdrop-blur-sm max-w-4xl mx-auto px-4 py-3 flex justify-between items-center">
      <div class="flex items-center">
        <h1 class="text-xl">
          <a href="{{ '/' | relative_url }}">{{ site.first_name | upcase }} {{ site.last_name | upcase }}</a>
        </h1>
      </div>
      <div class="mr-2">
        <button id="hamburger-button" class="text-sm md:hidden cursor-pointer relative w-8 h-8">&#9776;</button>
        <nav class="hidden md:flex items-center space-x-8 text-sm" aria-label="main">
          <a href="{{ '/news/' | relative_url }}" class="hover:opacity-70">News</a>
          <a href="{{ '/publications/' | relative_url }}" class="hover:opacity-70">Publications</a>
          <button id="theme-button" class="hover:opacity-70 cursor-pointer text-slate-900 dark:text-white">
            <i class="fa-solid fa-circle-half-stroke"></i>
          </button>
        </nav>
      </div>
    </section>
    <!-- Mobile menu -->
    <section id="mobile-menu" class="fixed hidden inset-0 backdrop-blur-sm justify-center items-start top-14 text-xl animate-open-menu origin-top">
      <nav class="flex flex-col p-4 w-full mx-4 bg-slate-100 dark:bg-slate-900 border border-gray-300 dark:border-white rounded-xl" aria-label="mobile">
        <a href="{{ '/news/' | relative_url }}" class="pb-3 hover:opacity-70">News</a>
        <a href="{{ '/publications/' | relative_url }}" class="pb-3 hover:opacity-70">Publications</a>
        <div class="flex justify-between items-center">
          <button id="theme-button" class="hover:opacity-70 cursor-pointer text-slate-900 dark:text-white">
            <i class="fa-solid fa-circle-half-stroke"></i> Toggle theme
          </button>
        </div>
      </nav>
    </section>
  </header>

  <!-- Content -->
  <main class="max-w-4xl mx-auto mb-8">
    {{ content }}
  </main>

  <!-- Footer -->
  <footer class="text-center text-xs font-extralight text-slate-500 dark:text-slate-400 py-6">
    &copy; {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.last_name }}.
    Powered by <a class="underline" href="https://jekyllrb.com/" target="_blank">Jekyll</a>.
    Hosted by <a class="underline" href="https://pages.github.com/" target="_blank">GitHub Pages</a>.
  </footer>

</body>
</html>
