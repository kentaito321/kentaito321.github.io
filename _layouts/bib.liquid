---
---
{% comment %}
  Renders one BibTeX entry as a publication card.
  Publications live in _bibliography/papers.bib -- edit that, not this file.

  Recognised fields beyond standard BibTeX:
    abbr      badge text, e.g. abbr={CVPR 2026}
    is_new    is_new={true} adds a "New" badge
    award     award={Best Presentation Award} adds an award badge
    preview   image filename in assets/img/publication_preview/
    pdf       URL, or a filename in assets/pdf/
    website   project page URL
    code      repository URL
    dataset   dataset URL (Hugging Face, Zenodo, ...)
    slides, poster, video, demo, html   extra link buttons
{% endcomment %}
{% assign btn = "inline-flex items-center gap-1.5 rounded-full border border-slate-300 dark:border-slate-600 px-3 py-1 text-xs uppercase tracking-wide hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" %}

<article class="flex flex-col sm:flex-row gap-4 rounded-xl border border-slate-200 dark:border-slate-700 p-4 hover:shadow-lg transition-shadow duration-200">

  <div class="sm:w-48 shrink-0">
    {% if entry.preview %}
      {% if entry.preview contains '://' %}
        <img class="w-full rounded-md" src="{{ entry.preview }}" alt="{{ entry.title }}">
      {% else %}
        {% assign preview_path = entry.preview | prepend: '/assets/img/publication_preview/' %}
        <img class="w-full rounded-md" src="{{ preview_path | relative_url }}" alt="{{ entry.title }}">
      {% endif %}
    {% else %}
      <div class="aspect-video rounded-md bg-gradient-to-br from-slate-200 to-slate-400 dark:from-slate-700 dark:to-slate-800"></div>
    {% endif %}
  </div>

  <div class="flex-1 min-w-0">

    <div class="flex flex-wrap items-center gap-2">
      {% if entry.abbr %}
        <span class="rounded-full border border-slate-400 dark:border-slate-500 px-2.5 py-0.5 text-[11px] font-medium uppercase tracking-wide text-slate-600 dark:text-slate-300">{{ entry.abbr }}</span>
      {% endif %}
      {% if entry.is_new %}
        <span class="rounded-full bg-slate-900 dark:bg-white px-2.5 py-0.5 text-[11px] font-medium text-white dark:text-slate-900">New</span>
      {% endif %}
      {% if entry.award %}
        <span class="inline-flex items-center gap-1 rounded-full bg-slate-900 dark:bg-white px-2.5 py-0.5 text-[11px] font-medium text-white dark:text-slate-900"><i class="fa-solid fa-award"></i> {{ entry.award }}</span>
      {% endif %}
    </div>

    <h4 class="mt-2 text-base sm:text-lg font-semibold leading-snug">{{ entry.title }}</h4>

    <p class="mt-1 text-sm font-extralight text-slate-600 dark:text-slate-300">
      {%- assign n_authors = entry.author_array | size -%}
      {%- for author in entry.author_array -%}
        {%- assign author_last = author.last | remove: '*' | remove: '†' | remove: '¶' | remove: '^' -%}
        {%- assign is_self = false -%}
        {%- if site.scholar.last_name contains author_last -%}
          {%- if site.scholar.first_name contains author.first -%}
            {%- assign is_self = true -%}
          {%- endif -%}
        {%- endif -%}
        {%- unless forloop.first -%}
          {%- if forloop.last -%}
            {%- if n_authors > 2 -%}, and {% else %} and {% endif -%}
          {%- else -%}, {% endif -%}
        {%- endunless -%}
        {%- if is_self -%}
          <span class="font-semibold underline underline-offset-2">{{ author.first }} {{ author.last }}</span>
        {%- else -%}
          {{ author.first }} {{ author.last }}
        {%- endif -%}
      {%- endfor -%}
    </p>

    <div class="mt-3 flex flex-wrap gap-2">
      {% if entry.pdf %}
        {% if entry.pdf contains '://' or entry.pdf == '#' %}
          {% assign pdf_url = entry.pdf %}
        {% else %}
          {% assign pdf_url = entry.pdf | prepend: '/assets/pdf/' | relative_url %}
        {% endif %}
        <a href="{{ pdf_url }}" class="{{ btn }}"><i class="fa-solid fa-file-lines"></i> Paper</a>
      {% endif %}
      {% if entry.html %}
        <a href="{{ entry.html }}" class="{{ btn }}"><i class="fa-solid fa-link"></i> Link</a>
      {% endif %}
      {% if entry.code %}
        <a href="{{ entry.code }}" class="{{ btn }}"><i class="fa-brands fa-github"></i> Code</a>
      {% endif %}
      {% if entry.website %}
        <a href="{{ entry.website }}" class="{{ btn }}"><i class="fa-solid fa-globe"></i> Project Page</a>
      {% endif %}
      {% if entry.dataset %}
        <a href="{{ entry.dataset }}" class="{{ btn }}"><i class="fa-solid fa-database"></i> Dataset</a>
      {% endif %}
      {% if entry.demo %}
        <a href="{{ entry.demo }}" class="{{ btn }}"><i class="fa-solid fa-wand-magic-sparkles"></i> Demo</a>
      {% endif %}
      {% if entry.slides %}
        <a href="{{ entry.slides }}" class="{{ btn }}"><i class="fa-solid fa-display"></i> Slides</a>
      {% endif %}
      {% if entry.video %}
        <a href="{{ entry.video }}" class="{{ btn }}"><i class="fa-solid fa-video"></i> Video</a>
      {% endif %}
      {% if entry.poster %}
        <a href="{{ entry.poster }}" class="{{ btn }}"><i class="fa-solid fa-image"></i> Poster</a>
      {% endif %}
    </div>

  </div>
</article>
